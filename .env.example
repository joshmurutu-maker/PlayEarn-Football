# Generate a unique random secret of at least 32 characters. Server-only; never VITE_ prefixed.
PEF_ADMIN_TOKEN=
API_PORT=8787
# Local development only. Never enable in production.
PEF_ENABLE_DEMO_SETTLEMENTS=false
# Optional local ledger file. JSON ledger is NOT durable on serverless hosting.
PEF_LEDGER_FILE=./data/revenue-ledger.json

# Arbitrum Sepolia TESTNET ONLY — no real monetary value.
PEF_ENABLE_TESTNET_TRANSFERS=false
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_PRIVATE_KEY=

# Production configuration placeholders. Not consumed by this scaffold; do not enable until
# a durable database, signed payment source, reviewed swap route and managed signer are integrated.
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc
PEF_PAYOUT_DESTINATION=0x8ADA31eC4E4B58d6DE5545A4dbd4C4c2b436B8Ea
PEF_ENABLE_MAINNET_PAYOUTS=false
PEF_USDT_TOKEN_ADDRESS=
PEF_SWAP_ROUTER_ADDRESS=
PEF_DATABASE_URL=
PEF_PAYMENT_WEBHOOK_SECRET=
PEF_SIGNER_SECRET_REF=
